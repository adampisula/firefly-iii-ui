# Local-only examples. Replace all values before running; do not use these credentials outside a disposable setup.
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8081
BACKEND_INTERNAL_API_URL=http://firefly:8080/api/v1
# The Compose example mounts a persistent volume here for per-user appearance data.
FRONTEND_DATA_DIR=/app/data
FRONTEND_IMAGE=ghcr.io/adampisula/firefly-iii-ui:latest
FIREFLY_IMAGE=fireflyiii/core:version-6.7.9
FIREFLY_HTTP_PORT=8081
FRONTEND_HTTP_PORT=3000
POSTGRES_PASSWORD=local-only-change-me
FIREFLY_APP_KEY=SomeRandomStringOf32CharsExactly
